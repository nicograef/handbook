# Copy to backend/Dockerfile, the name release.yml builds, and copy .dockerignore beside it.
# Fill <package>: the import name under src/ that `uv init --package` created, `backend` by default.
# The app answers GET /api/health on port 8080; the production Compose files poll its healthcheck.
# One stage suffices: the base image already carries the interpreter and the resolver.

# Both versions literal: `latest` or `python3.12` alone would move under a frozen lockfile.
# The uv version repeats the [tool.uv] required-version floor in pyproject.toml, the version CI runs;
# the Python version repeats .python-version.
FROM ghcr.io/astral-sh/uv:0.12.18-python3.12-trixie-slim

# Compile bytecode once at build time; copy instead of hardlink across the cache boundary.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

# Dependencies alone, keyed on the two files that pin them: a source edit rebuilds nothing here.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# The package build reads README.md: `uv init --package` names it as the project readme.
COPY README.md ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Created after the sync, so the venv is owned by root and only read by the service.
RUN useradd --create-home --uid 10001 app
USER app

EXPOSE 8080
# The slim image ships no wget or curl, so the probe uses the interpreter.
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/api/health', timeout=2)"]
# An empty host binds one IPv4 and one IPv6 socket, so IPv6-only Compose networks work too;
# `::` alone would be IPv6-only, since asyncio sets IPV6_V6ONLY.
# Trusting every proxy's X-Forwarded-* is safe: the Compose file publishes no backend port.
CMD ["uvicorn", "--factory", "<package>.api:app", "--host", "", "--port", "8080", "--forwarded-allow-ips", "*"]
