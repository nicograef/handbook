# .env.example — standard environment variables for Docker Compose templates
# Copy to .env and fill in real values. Never commit .env to version control.
#
# Used by: docker-compose.yml, docker-compose.prod.yml, Makefile

# ── Database ──
POSTGRES_USER=admin
POSTGRES_PASSWORD=<your-db-password>
POSTGRES_DB=<your-database-name>

# ── Application ──
# APP_PORT=8080
# APP_ENV=production

# ── Secrets ──
# JWT_SECRET=<your-jwt-secret>

# ── Monitoring ──
# Dead-man's-switch URLs (e.g. Better Stack heartbeats), pinged only on success.
# Per-server config — never commit them. Setup: guides/monitoring.md.
# Pinged by scripts/backup-postgres.sh after a verified backup:
# BACKUP_PING_URL=<your-ping-url>
# Pinged by the certbot service after a successful `certbot renew`:
# CERT_PING_URL=<your-ping-url>
