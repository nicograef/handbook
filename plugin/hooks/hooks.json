{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"${CLAUDE_PLUGIN_ROOT}/scripts/git-guard.sh\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/scripts/git-guard.sh\""
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{t:(now|todate),cwd,tool:.tool_name,cmd:(.tool_input.command // .tool_input.file_path // \"\"),reason}' >> \"$HOME/.claude/denials.log\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/agent-bus.sh\" ] || exit 0; \"$HOME/.claude/agent-bus.sh\" hook session-start || exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-run-guard.sh\" ] || exit 0; \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-run-guard.sh\" || exit 0"
          }
        ]
      }
    ]
  }
}
