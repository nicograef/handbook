{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 90,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(file:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git stash list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(go version)",
      "Bash(go env:*)",
      "Bash(go list:*)",
      "Bash(go mod tidy:*)",
      "Bash(go mod download:*)",
      "Bash(go mod verify:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go tool goimports:*)",
      "Bash(go tool sqlc:*)",
      "Bash(goimports:*)",
      "Bash(sqlc:*)",
      "Bash(golangci-lint:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(pnpm --version)",
      "Bash(pnpm install:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm tsc:*)",
      "Bash(pnpm ls:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm audit)",
      "Bash(pnpm audit --audit-level:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(npm ls:*)",
      "Bash(npm view:*)",
      "Bash(npm outdated:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(make:*)",
      "Bash(psql --version)",
      "Bash(jq:*)",
      "Bash(rg:*)",
      "Bash(sed -n:*)",
      "Bash(df:*)",
      "Bash(php -l:*)",
      "Bash(php -S localhost:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh api:*)",
      "Bash(uv run:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(~/.claude/agent-bus.sh:*)",
      "Bash(~/.claude/check-agents.sh:*)",
      "Bash(~/.claude/plan-run-guard.sh:*)",
      "Bash(~/.claude/skills/audiobook/md-to-epub.sh:*)",
      "Bash(~/.claude/skills/audiobook/check-terms.sh:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(uv audit:*)",
      "Bash(python3 --version)",
      "Bash(uv --version)",
      "Bash(uv add:*)",
      "Bash(uv tool:*)",
      "Bash(uv tree:*)",
      "Bash(uv pip list:*)",
      "Bash(uv python list:*)",
      "Bash(docker compose up -d:*)",
      "Bash(docker compose build:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git ls-remote:*)",
      "Bash(git merge-tree:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree prune:*)",
      "Bash(git worktree repair:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git fsck:*)",
      "Bash(git rm:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo rm:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore .:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(git gc --prune=now:*)",
      "Bash(git update-ref:*)",
      "Bash(git rebase --update-refs:*)",
      "Bash(git stash)",
      "Bash(git stash push:*)",
      "Bash(git stash pop:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)"
    ],
    "ask": [
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f*)",
      "Bash(gh api *-F*)",
      "Bash(gh api *--input*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5",
  "availableModels": [
    "claude-opus-5-5",
    "claude-sonnet-5"
  ],
  "enforceAvailableModels": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/git-guard.sh\" ] || exit 0; exec \"$HOME/.claude/git-guard.sh\""
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{t:(now|todate),cwd,tool:.tool_name,cmd:(.tool_input.command // .tool_input.file_path // \"\"),reason}' >> \"$HOME/.claude/denials.log\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/agent-bus.sh\" ] || exit 0; \"$HOME/.claude/agent-bus.sh\" hook session-start || exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/plan-run-guard.sh\" ] || exit 0; \"$HOME/.claude/plan-run-guard.sh\" || exit 0"
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\"",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "outputStyle": "Proactive",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "preferredNotifChannel": "auto",
  "fileCheckpointingEnabled": false,
  "showTurnDuration": true,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: Nico Gräf's machines; the machine's managed settings name his employer, its hosts and its served stacks. Claude Code runs on single-user Linux machines. Primary use: software development, plus personal projects.",
      "Source control: GitHub. Personal org github.com/nicograef with SSH remotes git@github.com:nicograef/<repo>.git. The company's GitHub org and remotes: the machine's managed settings in /etc/claude-code/managed-settings.d/ name them.",
      "Repository visibility: handbook is public. Treat every other repo, company or personal, as private.",
      "Trusted repo: every git repository under /home/nico/r, and every <repo>-wt/ directory beside one, which holds that repository's worktrees.",
      "Cloud provider(s): the machine's managed settings in /etc/claude-code/managed-settings.d/ name them.",
      "Key internal services: the Docker Compose stacks each repo defines, and dev servers on localhost. Company services: the machine's managed settings in /etc/claude-code/managed-settings.d/ name them.",
      "Internal package registry: the machine's managed settings in /etc/claude-code/managed-settings.d/ name it. The public npm registry, Go module proxy, PyPI and crates.io are the expected registries.",
      "Sensitive data locations & audiences: /home/nico/.claude holds session transcripts and credentials. Company source code and data are confidential. None of it leaves this machine except through the company's own git remotes, and none belongs in a PR body, paste, or third-party service.",
      "Sensitive remote targets: the machine's managed settings name them. An agent session deploys nothing.",
      "Protected IaC scopes: the machine's managed settings in /etc/claude-code/managed-settings.d/ name them. An agent session never runs an infrastructure deploy or destroy command.",
      "Additional context: single-user machines, no CI secrets held locally. Agent sessions work in git worktrees under ../<repo>-wt/. In every repository a session may commit to and push feature branches and main; it never force-pushes."
    ]
  }
}
